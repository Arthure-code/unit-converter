<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UnitConverter.App.Pages.ConverterPage"
    Title="Convertisseur">

    <!--
    Why a Grid inside a ScrollView: the page holds four bands, the readout,
    the clear keys, the conversions and the keypad. Each band takes the
    height it needs, which is one RowDefinitions line here and would be
    nested stacks otherwise, and the ScrollView carries what does not fit
    on a short window or a small phone rather than squashing the keys.
    -->

    <ScrollView>
    <Grid
        Padding="10"
        RowSpacing="15"
        RowDefinitions="Auto,Auto,Auto,Auto">

        <Grid
            Grid.Row="0"
            ColumnSpacing="5"
            RowSpacing="5"
            ColumnDefinitions="30*,70*"
            RowDefinitions="Auto,Auto">

            <Label
                x:Name="SourceUnit"
                Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource UnitLabel}" />

            <Label
                x:Name="SourceValue"
                Grid.Row="0"
                Grid.Column="1"
                Style="{StaticResource ValueLabel}" />

            <Label
                x:Name="TargetUnit"
                Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource UnitLabel}" />

            <Label
                x:Name="TargetValue"
                Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource ValueLabel}" />
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnSpacing="8"
            ColumnDefinitions="3*,*">

            <Button
                Grid.Column="0"
                Text="EFFACER"
                Style="{StaticResource ClearButton}"
                Clicked="Clear_Clicked" />

            <Button
                x:Name="BackspaceKey"
                Grid.Column="1"
                Text="&#x232B;"
                SemanticProperties.Description="Effacer la dernière touche"
                Style="{StaticResource ClearButton}"
                Clicked="Backspace_Clicked" />
        </Grid>

        <Grid
            x:Name="Conversions"
            Grid.Row="2"
            ColumnSpacing="8"
            RowSpacing="8"
            ColumnDefinitions="*,*,*,*"
            RowDefinitions="Auto,Auto,Auto">

            <Button Text="CM À POUCE" CommandParameter="cm-to-in"
                    Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource ConversionButton}" Clicked="Convert_Clicked" />

            <Button Text="POUCE À CM" CommandParameter="in-to-cm"
                    Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource ConversionButton}" Clicked="Convert_Clicked" />

            <Button Text="M À PIED" CommandParameter="m-to-ft"
                    Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource ConversionButton}" Clicked="Convert_Clicked" />

            <Button Text="PIED À M" CommandParameter="ft-to-m"
                    Grid.Row="0" Grid.Column="3"
                    Style="{StaticResource ConversionButton}" Clicked="Convert_Clicked" />

            <Button Text="G À ONCE" CommandParameter="g-to-oz"
                    Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource ConversionButton}" Clicked="Convert_Clicked" />

            <Button Text="ONCE À G" CommandParameter="oz-to-g"
                    Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource ConversionButton}" Clicked="Convert_Clicked" />

            <Button Text="KG À LB" CommandParameter="kg-to-lb"
                    Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource ConversionButton}" Clicked="Convert_Clicked" />

            <Button Text="LB À KG" CommandParameter="lb-to-kg"
                    Grid.Row="1" Grid.Column="3"
                    Style="{StaticResource ConversionButton}" Clicked="Convert_Clicked" />

            <Button Text="KM À MI" CommandParameter="km-to-mi"
                    Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource ConversionButton}" Clicked="Convert_Clicked" />

            <Button Text="MI À KM" CommandParameter="mi-to-km"
                    Grid.Row="2" Grid.Column="1"
                    Style="{StaticResource ConversionButton}" Clicked="Convert_Clicked" />

            <Button Text="&#176;C À &#176;F" CommandParameter="c-to-f"
                    Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource ConversionButton}" Clicked="Convert_Clicked" />

            <Button Text="&#176;F À &#176;C" CommandParameter="f-to-c"
                    Grid.Row="2" Grid.Column="3"
                    Style="{StaticResource ConversionButton}" Clicked="Convert_Clicked" />
        </Grid>

        <Grid
            x:Name="Keypad"
            Grid.Row="3"
            ColumnSpacing="10"
            RowSpacing="10"
            ColumnDefinitions="*,*,*"
            RowDefinitions="Auto,Auto,Auto,Auto">

            <Button Text="7" CommandParameter="7" Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource DigitButton}" Clicked="Digit_Clicked" />

            <Button Text="8" CommandParameter="8" Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource DigitButton}" Clicked="Digit_Clicked" />

            <Button Text="9" CommandParameter="9" Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource DigitButton}" Clicked="Digit_Clicked" />

            <Button Text="4" CommandParameter="4" Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource DigitButton}" Clicked="Digit_Clicked" />

            <Button Text="5" CommandParameter="5" Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource DigitButton}" Clicked="Digit_Clicked" />

            <Button Text="6" CommandParameter="6" Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource DigitButton}" Clicked="Digit_Clicked" />

            <Button Text="1" CommandParameter="1" Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource DigitButton}" Clicked="Digit_Clicked" />

            <Button Text="2" CommandParameter="2" Grid.Row="2" Grid.Column="1"
                    Style="{StaticResource DigitButton}" Clicked="Digit_Clicked" />

            <Button Text="3" CommandParameter="3" Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource DigitButton}" Clicked="Digit_Clicked" />

            <Button Text="." Grid.Row="3" Grid.Column="0"
                    SemanticProperties.Description="Virgule décimale"
                    Style="{StaticResource DigitButton}" Clicked="DecimalPoint_Clicked" />

            <Button Text="0" CommandParameter="0" Grid.Row="3" Grid.Column="1"
                    Style="{StaticResource DigitButton}" Clicked="Digit_Clicked" />

            <Button Text="&#177;" Grid.Row="3" Grid.Column="2"
                    SemanticProperties.Description="Changer le signe"
                    Style="{StaticResource DigitButton}" Clicked="Sign_Clicked" />
        </Grid>

    </Grid>
    </ScrollView>
</ContentPage>
