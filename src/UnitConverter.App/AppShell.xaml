<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UnitConverter.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:UnitConverter.App.Pages"
    Title="Convertisseur d'unités">

    <!-- A flyout menu: the three pages sit side by side, none of them is a
         step inside another, so none of them needs a back button. -->

    <FlyoutItem Title="Convertisseur">
        <ShellContent ContentTemplate="{DataTemplate pages:ConverterPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Aide">
        <ShellContent ContentTemplate="{DataTemplate pages:HelpPage}" />
    </FlyoutItem>

    <FlyoutItem Title="À propos">
        <ShellContent ContentTemplate="{DataTemplate pages:AboutPage}" />
    </FlyoutItem>

</Shell>
